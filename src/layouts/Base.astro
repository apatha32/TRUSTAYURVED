---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import Sky from '../components/Sky.astro';
import marcellus from '@fontsource/marcellus/files/marcellus-latin-400-normal.woff2?url';
import { WHATSAPP_URL } from '../lib/content';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
  noindex?: boolean;
  published?: string;
}
const seo = Astro.props;
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#F3F6F2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F1813" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={marcellus} as="font" type="font/woff2" crossorigin />
    <Seo {...seo} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Sky />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <div class="action-bar" role="region" aria-label="Quick actions">
      <a class="btn" href={WHATSAPP_URL} target="_blank" rel="noopener" data-ripple><Icon name="whatsapp" />WhatsApp us</a>
      <a class="btn btn--ghost" href="/contact/" data-ripple><Icon name="phone" />Contact</a>
    </div>
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
