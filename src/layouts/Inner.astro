---
/** Inner pages: short calm hero with a *still* leaf/water motif (no animation —
    the homepage keeps the signature), then readable content. */
import Base from './Base.astro';
import Motif from '../components/Motif.astro';

interface Props {
  title: string;          // <title> (live site's, verbatim)
  description: string;
  heading: string;        // page H1 (live site's page title heading, verbatim)
  eyebrow?: string;
  crumbs?: { label: string; href?: string }[];
  image?: ImageMetadata;
  type?: 'website' | 'article';
  published?: string;
  noindex?: boolean;
}
const { heading, eyebrow, crumbs = [], ...rest } = Astro.props;
---
<Base {...rest}>
  <section class="page-hero">
    <Motif name="still-water" class="page-hero__motif" />
    <div class="container">
      <div class="page-hero__inner">
        {crumbs.length > 0 && (
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
            </ol>
          </nav>
        )}
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="display">{heading}</h1>
        <slot name="hero" />
      </div>
    </div>
  </section>
  <slot />
</Base>
