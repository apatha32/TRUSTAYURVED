const whatsapp = '<path fill="currentColor" stroke="none" d="M12.04 2.5A9.43 9.43 0 0 0 3.9 16.7L2.5 21.5l4.93-1.29A9.43 9.43 0 1 0 12.04 2.5zm0 17.24a7.8 7.8 0 0 1-3.98-1.09l-.29-.17-2.93.77.78-2.85-.19-.3a7.82 7.82 0 1 1 6.61 3.64zm4.29-5.85c-.24-.12-1.39-.69-1.6-.76-.22-.08-.37-.12-.53.12-.16.23-.61.76-.75.92-.14.16-.28.18-.51.06a6.4 6.4 0 0 1-1.89-1.17 7.1 7.1 0 0 1-1.3-1.63c-.14-.24 0-.36.1-.48.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.53-1.28-.73-1.75-.19-.46-.39-.4-.53-.4h-.45a.87.87 0 0 0-.63.29 2.64 2.64 0 0 0-.83 1.97 4.6 4.6 0 0 0 .96 2.43 10.5 10.5 0 0 0 4.03 3.56c.56.24 1 .39 1.35.5.56.18 1.08.15 1.48.09.45-.07 1.39-.57 1.58-1.12.2-.55.2-1.02.14-1.12-.06-.1-.22-.16-.45-.28z"/>';
const body = name === 'whatsapp' ? whatsapp : P[name];
if (body === undefined) throw new Error(`Unknown icon ${name}`);
---
<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={body}
/>
