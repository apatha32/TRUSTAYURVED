  'sound-on': '<path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4z"/><path d="M15.5 9a4.5 4.5 0 0 1 0 6M18 6.5a8 8 0 0 1 0 11"/>',
  expand: '<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/>',
  /* services */
  mind: '<path d="M12 20.5v-3.2M8.2 17.3h7.6"/><path d="M12 17.3c-3.9 0-6.7-2.8-6.7-6.5S8.1 4 12 4s6.7 3 6.7 6.8-2.8 6.5-6.7 6.5z"/><path d="M8 10.2c1.3-1.2 2.7-1.2 4 0s2.7 1.2 4 0M8.5 13c1.2-.9 2.3-.9 3.5 0s2.3.9 3.5 0"/>',
