  joint: '<path d="M8.5 3.5v6.2a3.5 3.5 0 0 0 7 0V3.5"/><path d="M8.5 20.5v-4.7a3.5 3.5 0 0 1 7 0v4.7"/><path d="M6 12.8h2.2M15.8 12.8H18"/>',
