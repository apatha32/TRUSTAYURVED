---
/** Responsive AVIF/WebP picture for a crawled upload. */
import { Picture } from 'astro:assets';
import { wpImage } from '../lib/images';
interface Props { src: string; alt: string; sizes?: string; widths?: number[]; eager?: boolean; class?: string; position?: string }
const { src, alt, sizes = '(min-width: 64rem) 600px, 100vw', widths, eager = false, class: cls, position } = Astro.props;
const meta = wpImage(src);
const ws = (widths ?? [360, 640, 960, 1280]).filter((w) => w <= meta.width);
if (!ws.length) ws.push(meta.width);
---
<Picture
  src={meta}
  alt={alt}
  formats={['avif', 'webp']}
  widths={ws}
  sizes={sizes}
  loading={eager ? 'eager' : 'lazy'}
  decoding={eager ? 'sync' : 'async'}
  fetchpriority={eager ? 'high' : undefined}
  class={cls}
  style={position ? `object-position:${position}` : undefined}
/>
