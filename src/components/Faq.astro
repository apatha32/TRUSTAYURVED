---
/** Accessible accordion: native <details>/<summary>, smooth height via ::details-content. */
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq" data-reveal>
  {items.map((f) => (
    <details>
      <summary><span>{f.q}</span><span class="faq__icon" aria-hidden="true"></span></summary>
      <div class="faq__answer"><p>{f.a}</p></div>
    </details>
  ))}
</div>
