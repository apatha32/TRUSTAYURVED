---
import { getImage } from 'astro:assets';
import { wpImage, SHIRODHARA } from '../lib/images';
import { WHATSAPP_URL } from '../lib/content';

interface Props { title: string; description: string; image?: ImageMetadata; type?: 'website' | 'article'; noindex?: boolean; published?: string }
const { title, description, image, type = 'website', noindex = false, published } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: image ?? wpImage(SHIRODHARA), width: 1200, format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, Astro.site).href;
const isHome = Astro.url.pathname === '/';

/* schema.org — only facts already published on the live site (Privacy Policy / Terms contact blocks). */
const clinic = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  '@id': 'https://trustayurved.com/#clinic',
  name: 'Shraddha Ayurvedic Clinic',
  url: 'https://trustayurved.com/',
  logo: new URL('/icon-512.png', Astro.site).href,
  image: ogUrl,
  email: 'info@shraddhaayurveda.com',
  telephone: ['0240-2344854', '+91 9822303175', '+91 9595450251', '+91 9552561079'],
  description: 'Shraddha Ayurvedic Clinic is dedicated to providing authentic Ayurvedic treatments, Panchakarma therapies, and holistic wellness solutions for complete physical, mental, and emotional healing naturally.',
  sameAs: [WHATSAPP_URL],
  department: [
    {
      '@type': 'MedicalClinic', name: 'Chhatrapati Sambhajinagar Clinic',
      telephone: ['0240-2344854', '+91 9822303175', '+91 9595450251', '+91 9552561079'],
      address: { '@type': 'PostalAddress', streetAddress: 'Flat No. 1, Chetan Plaza, Beside Renuka Driving School, Opposite Roplekar Hospital, Samrat Nagar', addressLocality: 'Chhatrapati Sambhajinagar', addressRegion: 'Maharashtra', postalCode: '431005', addressCountry: 'IN' },
    },
    {
      '@type': 'MedicalClinic', name: 'Pune Clinic',
      telephone: '+91 9822303175',
      address: { '@type': 'PostalAddress', streetAddress: 'Varad Polyclinic, Shivram Smruti Apartment, 561, Shaniwar Peth, Opp. HDFC Bank, Above Vrundavan Fresh, Raman Baug Chowk', addressLocality: 'Pune', addressRegion: 'Maharashtra', postalCode: '411030', addressCountry: 'IN' },
    },
  ],
  employee: [
    { '@type': 'Physician', name: 'Vd. Sohan Pathak', url: 'https://trustayurved.com/vd-sohan-pathak/' },
    { '@type': 'Physician', name: 'Vd. Ashwini Pathak', url: 'https://trustayurved.com/vd-ashwini-pathak/' },
  ],
};
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Shraddha Ayurvedic Clinic" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:locale" content="en_IN" />
{published && <meta property="article:published_time" content={published} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
{isHome && <script type="application/ld+json" set:html={JSON.stringify(clinic)} />}
